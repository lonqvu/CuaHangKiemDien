# Copy thanh .env roi doi gia tri that truoc khi chay (KHONG dua .env len git)
# Tao chuoi ngau nhien:  openssl rand -base64 24   (mat khau DB)   /   openssl rand -base64 48   (JWT_SECRET)
DB_PASSWORD=change-me
JWT_SECRET=change-me-with-at-least-32-characters-random
# mat khau admin LAN DAU (tao tai khoan admin khi DB trong); dang nhap xong nen doi ngay trong app
ADMIN_PASSWORD=change-me
# Chi dung cho VPS (docker-compose.vps.yml): ten mien tro ve IP VPS, vd banhang.nhomsatkiemdien.vn
# Chua co ten mien: dung <IP VPS>.sslip.io, vd 103.20.30.40.sslip.io (van co HTTPS)
DOMAIN=
# Tuy chon: chi cho cac IP nay vao web (cach nhau dau cach, IP hoac dai CIDR). De trong = moi IP.
# Luu y: 4G dien thoai va mang nha thuong DOI IP -> muon chi may minh vao duoc thi dung Tailscale (docs/trien-khai-vps.md)
ALLOWED_IPS=
